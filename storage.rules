rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /media/{uid}/{file} {
      // Only the owner uploads; max 100 MB per file
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 100 * 1024 * 1024;
      // Voice/video previews are readable by signed-in users.
      // NOTE: resume/portfolio download URLs are only ever stored in
      // profiles/{uid}/private/contact, which Firestore rules gate behind
      // the unlock paywall — so unpaid employers never receive the URL.
      allow read: if request.auth != null;
    }
  }
}
